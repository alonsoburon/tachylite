{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tachylite",
  "mainBinaryName": "tachylite",
  "version": "0.1.0",
  "identifier": "app.tachylite.desktop",
  "build": { "frontendDist": "../../ui/dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Tachylite", "width": 1280, "height": 800, "minWidth": 640, "minHeight": 400 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": [] } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["tachylite"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Markdown knowledge base compatible with Obsidian vaults",
    "longDescription": "Tachylite is a free and open-source note-taking app for folders of Markdown files. It opens Obsidian vaults as they are and runs their community plugins and themes.",
    "publisher": "Tachylite contributors",
    "copyright": "Copyright (c) 2026 Tachylite contributors",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/alonsoburon/tachylite",
    "linux": {
      "deb": { "section": "text", "depends": ["xdg-utils"], "desktopTemplate": "linux/tachylite.desktop" },
      "rpm": { "depends": ["xdg-utils"], "desktopTemplate": "linux/tachylite.desktop" },
      "appimage": { "bundleMediaFramework": false }
    },
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
